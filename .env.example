# ─────────────────────────────────────────────────────────────
# Varam store — environment variables
# Copy to .env on the server (cPanel: set them in the Node.js app screen instead)
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
SITE_URL=https://varam.in

# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# MySQL — the Unix socket is tried first, TCP is used if the socket is unavailable
DB_SOCKET=/run/mysqld/mysqld.sock
DB_HOST=10.169.9.188
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Max MySQL connections per app process (each Passenger worker has its own pool).
# Keep (workers x DB_POOL_SIZE) under your MySQL user's max_user_connections.
DB_POOL_SIZE=10

# First admin account (created on first boot only). Leave both empty to use the default
# login  admin@varam.in / Varam@12345  — then change the password from
# Admin → Coupons & settings (the dashboard reminds you until you do).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Varam Admin

# Optional: keep uploaded product images outside the app folder so redeploys never delete them
# UPLOAD_DIR=/home/<cpanel-user>/varam-uploads

# Set to false only if the app is NOT behind cPanel/Passenger or another proxy
TRUST_PROXY=true
SESSION_DAYS=14
