# ─────────────────────────────────────────────────────────────
# VARAM — environment variables (copy to .env.local for development)
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO, sitemap, Open Graph and structured data)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# WhatsApp business number — digits with country code, no + or spaces.
# This is the fallback; it can be overridden in Admin → Website content.
NEXT_PUBLIC_WHATSAPP_NUMBER=917799228444

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Analytics runs only in production builds by default. Set "true" to force on
# (e.g. a staging deployment with its own test property) or "false" to force off.
NEXT_PUBLIC_GA_ENABLED=
# "true" sends debug_mode so events appear in GA4 DebugView
NEXT_PUBLIC_GA_DEBUG=false

# PostgreSQL (Neon, Supabase, Vercel Postgres, RDS…). Required in production.
# Leave empty locally to use the embedded database in ./.data/pglite
DATABASE_URL=

# Admin login — generate with: npm run hash-password -- "your-strong-password"
ADMIN_EMAIL=owner@your-domain.in
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Image uploads in production (Vercel Blob). Locally, uploads go to ./.data/uploads
BLOB_READ_WRITE_TOKEN=

# Google reviews (optional) — Google Places API (New) key, restricted to the Places API.
# Without it, the site shows the rating summary saved in Admin → Website content.
GOOGLE_PLACES_API_KEY=
# Optional: the Place ID (find it with Google's "Place ID Finder"); otherwise found by name.
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=VARAM ORGANIC OIL Vijayawada
